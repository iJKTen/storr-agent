# LLM Provider: "openai" | "ollama" | "anthropic"
LLM_PROVIDER=openai

# OpenAI / Ollama
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Workspace
WORKSPACE_PATH=../eve
RULES_PATH=../storr-prompt/rules

# Terminal: "local" | "docker"
TERMINAL_MODE=local
DOCKER_CONTAINER=eve-dev

# LLM Temperature (0.0 = deterministic, 1.0 = max randomness)
LLM_TEMPERATURE=0.3

# Retries
MAX_RETRIES=3
MAX_EVAL_RETRIES=5
